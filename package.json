{
  "name": "nous-oska",
  "version": "0.1.0",
  "private": true,
  "description": "Phase 1: Browser Shell - Electron Application",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.js",
  "author": "Nous Contributors",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --build tsconfig.build.json && node scripts/copy-renderer.js",
    "build:clean": "tsc --build --clean tsconfig.build.json",
    "dev": "electron . --no-sandbox",
    "start": "electron .",
    "build:electron": "pnpm build && electron-builder",
    "build:electron:dir": "pnpm build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.nous.oska",
    "productName": "Nous",
    "copyright": "Copyright © 2024 Nous Contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "preload/**/*"
    ],
    "extraResources": [
      {
        "from": "src/renderer/index.html",
        "to": "renderer/index.html"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;WebBrowser"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
